<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.2.0</Version>
    <AssemblyName>easy</AssemblyName>
    <AssemblyTitle>Easy Shell</AssemblyTitle>
    <ApplicationIcon>EasyShell.ico</ApplicationIcon>
    <!--Publishes with NativeAOT (dotnet publish -r <rid> -p:PublishAot=true), calling .NET through the curated Standard library instead of reflection.-->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup Condition="'$(PublishAot)' == 'true' or '$(PublishTrimmed)' == 'true'">
    <!--Folds ShellLibraries.IsReflectionSupported to false, so the reflective library is removed from the binary rather than merely never called.-->
    <RuntimeHostConfigurationOption Include="EasyShell.Reflection.IsSupported" Value="false" Trim="true" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="EasyShell.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../EasyShell/EasyShell.csproj" />
  </ItemGroup>

</Project>
