<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!--Needed only by TerminalState's opaque termios roundtrip-->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>0.2.0</Version>
    <AssemblyTitle>Easy Shell</AssemblyTitle>
    <!--Depends on entire .Net runtime-->
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <!--BuildCommandProcessorArguments is pure string work whose whole point is a rule of cmd.exe's;
        the test for it has to run on every platform, and it does not belong in the public surface.-->
    <InternalsVisibleTo Include="EasyShell.Tests" />
  </ItemGroup>

</Project>
