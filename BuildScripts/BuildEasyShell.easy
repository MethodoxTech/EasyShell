# A script to build Easy Shell with dotnet for publish
# To build with this script: easy "BuildEasyShell.easy"
# There is no need to set working directory etc.
#
# BuildEasyShell.ps1 does the same job for a machine that has no `easy` yet. The two are meant to stay behaviourally identical; when you change one, change the other.
#
# Pass --skip-tests when you know what you are doing: easy BuildEasyShell.easy --skip-tests
#
# Pass --build Native for the NativeAOT build: easy BuildEasyShell.easy --build Native. Full, the default, is the distribution as it always was - self-contained on the JIT, reaching any .NET type by reflection; Native is one native executable calling .NET through the curated Standard library, and needs the platform's C/C++ linker.

# Start
print "Publish for Final Packaging build."
$Build = (argvalue "--build" "Full")
assert (OR (== $Build "Full") (== $Build "Native")) (|| "The builds are Full and Native, not " $Build ".")

# A hung restore or test run should fail the build, not occupy the agent forever.
INTVAR EasyProcessTimeoutSeconds 1800

# Paths. RESOLVE collapses the ".." segments, so comparisons and messages below read cleanly.
# Project and tests sit beside this script's folder; only the shared output tree is repo-relative,
# so EasyShell keeps building if it is ever vendored at a different depth.
$EasyShellRoot = (resolve (JoinPath $EasyScriptRoot ".."))
$RepoRoot      = (resolve (JoinPath $EasyShellRoot ".." ".."))
$ProjectPath   = (JoinPath $EasyShellRoot "EasyShell.Cli")
$TestsPath     = (JoinPath $EasyShellRoot "EasyShell.Tests")
# The two builds publish side by side, so neither replaces the other: Full where `easy` has always been, Native beside it.
$PackageName   = (?: (== $Build "Native") "EasyShellNative" "EasyShell")
stringvar PublishFolder (JoinPath $RepoRoot "Publish" "Utilities" $PackageName "Current")
$ArchiveFolder = (JoinPath $RepoRoot "Publish" "Packages")

# The RID the runtime reports for this machine. Passed explicitly to `dotnet publish` AND used to name the package, so the two can never disagree - which guessing from pointer size does on arm64.
$Rid = (System.Runtime.InteropServices.RuntimeInformation.RuntimeIdentifier)
print (|| "Build: " $Build ". Target runtime: " $Rid " (Release)")

# Do not publish something that does not pass its own tests.
IF (NOT (hasarg "--skip-tests"))
    print "Running unit tests."
    dotnet test $TestsPath --configuration Release --nologo
END

# Refuse to delete the interpreter that is running this build. `easy` is normally installed from this very folder, so a self-hosted build would otherwise try to delete its own running exe - which on Windows fails partway through, leaving the publish folder half emptied.
$RunningProcess = (System.Environment.ProcessPath)
IF (EXISTS $RunningProcess)
    $RunningUpper = (System.String.ToUpperInvariant (resolve $RunningProcess))
    $PublishUpper = (System.String.ToUpperInvariant $PublishFolder)
    assert (NOT (System.String.StartsWith $RunningUpper $PublishUpper)) (|| "Refusing to overwrite " $PublishFolder ": the running interpreter (" $RunningProcess ") lives inside it. Run this build with an `easy` located elsewhere.")
END

# Delete current data
remove $PublishFolder

# NativeAOT links with the MSVC toolchain, found through Visual Studio's vcvarsall.bat; Visual Studio 18's copy runs vswhere.exe by bare name, so the installer folder has to be on PATH or the link fails with MSB3073.
$VsInstaller = (JoinPath (getenv "ProgramFiles(x86)") "Microsoft Visual Studio" "Installer")
IF (AND (== $Build "Native") (AND $IsWindows (EXISTS (JoinPath $VsInstaller "vswhere.exe"))))
    setenv "PATH" (|| (getenv "PATH") ";" $VsInstaller)
END

# Publish Executable
dotnet publish $ProjectPath --runtime $Rid --self-contained --configuration Release --output $PublishFolder (|| "-p:EasyShellBuild=" $Build)

# Validation. The executable is the deliverable; a PDB only ever was a proxy for one.
$ExecutableName = "easy"
IF $IsWindows
    $ExecutableName = "easy.exe"
END
$ExecutablePath = (JoinPath $PublishFolder $ExecutableName)
assert (EXISTS $ExecutablePath) (|| "Build failed. Missing executable: " $ExecutablePath)

# Smoke test: a self-contained layout can be complete on disk and still not start. Asking the fresh binary for its own version proves it runs and yields the number the package is named after; a non-zero exit code from it aborts the build on the spot.
$Version = ($ExecutablePath --version)
$Reported = ($ExecutablePath --build)
assert (System.String.StartsWith $Reported $Build) (|| "Asked for the " $Build " build, but the published executable reports: " $Reported)
print (|| "Smoke test passed, version " $Version ", " $Reported ".")

# Strip development-only files from the package
removeall $PublishFolder "*.pdb"
removeall $PublishFolder "*.xml"

# Create archive. Version and date together, so two builds of one day stay distinguishable.
$Date = (format "{0:yyyyMMdd}" (GetDate))
$ArchivePath = (JoinPath $ArchiveFolder (|| "Utility_" $PackageName "_" $Rid "_v" $Version "_B" $Date ".zip"))
mkdir $ArchiveFolder
zip $PublishFolder $ArchivePath

print (|| "Created package: " $ArchivePath)
